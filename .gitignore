# Dependencies (Massive folders that shouldn't be tracked)
node_modules/
jspm_packages/

# Environment secrets (Protects API keys and passwords)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production Build outputs
dist/
build/
out/
.next/
.nuxt/

# Logs & Runtime data
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed

# Test coverage results
coverage/
.nyc_output/

# IDE / System files (Prevents pushing personal settings)
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
